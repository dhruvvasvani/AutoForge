POSTGRES_PASSWORD=replace-with-a-strong-local-password
AUTOFORGE_INTERNAL_TOKEN=replace-with-a-long-random-token
AUTOFORGE_JWT_SECRET=replace-with-at-least-32-random-characters
AUTOFORGE_HTTP_PORT=8080
AUTOFORGE_WEBHOOK_PORT=8091

# Optional CPG-GNN checkpoint path inside the analyzer container.
# Uncomment only for experimental, informational file-level inference after
# reviewing the checkpoint's evaluation status.
CPG_GNN_CHECKPOINT=
CPG_GNN_MODEL_NAME=/models/codebert-base
# CPG_GNN_CHECKPOINT=/models/checkpoints/cpg_gnn_full_10epoch.pt

# Required shared HMAC secret for both the backend and pull-request analyzer.
AUTOFORGE_GITHUB_WEBHOOK_SECRET=
# Optional. Also enables dashboard scans of private repositories when granted
# repository Contents: read access. PR automation may require additional scopes.
GITHUB_TOKEN=
# Optional comma-separated allowlist; the backend still requires each repo
# to be connected before it accepts webhook scans.
GITHUB_REPOSITORY=
# Internal Docker-network URL used when dispatching PR events to the analyzer.
AUTOFORGE_GITHUB_PR_WEBHOOK_URL=http://webhook:8000/api/v1/github/events
# Optional, comma-separated dashboard origins when not using localhost.
WEBHOOK_CORS_ORIGINS=

# Optional OpenAI-compatible provider for AI remediation.
# Google AI Studio endpoint:
AUTOFORGE_LLM_API_KEY=
AUTOFORGE_LLM_MODEL=
AUTOFORGE_LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# For Neon deployment, use the prod Spring profile and configure:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<database>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<Neon user>
# SPRING_DATASOURCE_PASSWORD=<Neon password>
