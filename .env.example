POSTGRES_PASSWORD=replace-with-a-strong-local-password
AUTOFORGE_INTERNAL_TOKEN=replace-with-a-long-random-token
AUTOFORGE_JWT_SECRET=replace-with-at-least-32-random-characters

# Gemini AI remediation
AUTOFORGE_REMEDIATION_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AUTOFORGE_REMEDIATION_API_KEY=replace-with-your-gemini-api-key
AUTOFORGE_REMEDIATION_MODEL=gemini-2.5-flash
AUTOFORGE_HTTP_PORT=8080
AUTOFORGE_WEBHOOK_PORT=8091

# Optional CPG-GNN checkpoint path inside the analyzer container.
# Set after placing a compatible checkpoint in 3_ast_analyzer/src/ml.
CPG_GNN_CHECKPOINT=
CPG_GNN_MODEL_NAME=/models/codebert-base

# Required only for: docker compose --profile github up --build
WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REPOSITORY=
# Optional, comma-separated dashboard origins when not using localhost.
WEBHOOK_CORS_ORIGINS=

# For Neon deployment, use the prod Spring profile and configure:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<database>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<Neon user>
# SPRING_DATASOURCE_PASSWORD=<Neon password>
