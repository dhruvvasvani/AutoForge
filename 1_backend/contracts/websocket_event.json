{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoForgeWebSocketLogEvent",
  "description": "Event frame emitted by POST /api/v1/scans/{job_id}/logs and streamed over WS /api/v1/ws/scans/{job_id}",
  "type": "object",
  "properties": {
    "job_id": { "type": "integer" },
    "level": { "type": "string", "enum": ["DEBUG", "INFO", "WARN", "ERROR"] },
    "message": { "type": "string" },
    "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "required": ["job_id", "message"]
}
