{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoForgeScanJobQueueMessage",
  "description": "Agreed JSON message contract for Redis queue autoforge:scan_jobs",
  "type": "object",
  "properties": {
    "job_id": { "type": "string" },
    "project_id": { "type": "integer" },
    "repo_url": { "type": "string", "format": "uri" },
    "commit_sha": { "type": "string", "minLength": 7, "maxLength": 64 },
    "branch": { "type": "string", "default": "main" },
    "repository_id": { "type": "integer" },
    "scan_id": { "type": "integer" },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "job_id",
    "scan_id",
    "project_id",
    "repository_id",
    "repo_url",
    "commit_sha",
    "branch",
    "changed_files"
  ]
}
